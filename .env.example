# Personal OS Root Environment Configuration Template
# development enables the passwordless dev user and the default SECRET_KEY. Never use it on a server.
ENVIRONMENT=development
API_PORT=8008
WEB_PORT=3000
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@127.0.0.1:5432/personal_os_dev
REDIS_URL=redis://127.0.0.1:6379/0
GOOGLE_REDIRECT_URI=http://localhost:8008/v1/integrations/google/callback

# Telegram Mini App (served by nginx at /tg/). Enables the bot menu button.
TELEGRAM_MINIAPP_URL=
