# Database and Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@127.0.0.1:5432/personal_os_dev
REDIS_URL=redis://127.0.0.1:6379/0

# Security (Generate strong keys for production)
SECRET_KEY=change_me_to_a_secure_random_string_in_production
AES_GCM_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Environment & Server Ports
ENVIRONMENT=development
DEBUG=true
PORT=8008
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8008","http://127.0.0.1:3000","http://127.0.0.1:8008"]

# Google Calendar OAuth 2.0 Integration
# Web redirect URI format: http://localhost:8008/v1/integrations/google/callback (Host dev port: 8008)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8008/v1/integrations/google/callback

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
