# ==========================================
# Personal OS — Production Environment Template
# ==========================================

# Application
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate_64_char_secure_hex_string_here
APP_URL=https://app.personal-os.com
API_URL=https://app.personal-os.com/api

# Database (PostgreSQL 16 + pgvector)
POSTGRES_DB=personal_os_prod
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=generate_strong_db_password
DATABASE_URL=postgresql+asyncpg://pos_admin:generate_strong_db_password@postgres:5432/personal_os_prod

# Redis & Cache
REDIS_PASSWORD=generate_strong_redis_password
REDIS_URL=redis://:generate_strong_redis_password@redis:6379/0

# JWT & Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth Integrations (Google Calendar)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://app.personal-os.com/api/v1/integrations/google-calendar/callback
AES_GCM_SECRET_KEY=generate_32_byte_base64_encryption_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=generate_strong_telegram_webhook_secret

# AI & LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Object Storage / Backups (S3)
S3_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com
S3_BUCKET_NAME=personal-os-production-backups
S3_ACCESS_KEY_ID=your-aws-access-key
S3_SECRET_ACCESS_KEY=your-aws-secret-key
