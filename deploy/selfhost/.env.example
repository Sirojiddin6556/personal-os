# Copy to .env (never commit it). Generate secrets with: openssl rand -hex 32

# Public address served by the Cloudflare Tunnel, no trailing slash
PUBLIC_URL=https://os.example.com

# Without a domain: run `docker compose --profile quick up -d` (free Quick Tunnel);
# PUBLIC_URL is then discovered automatically, leave it as is.
# With a domain: set QUICK_TUNNEL_METRICS_URL= (empty), PUBLIC_URL, and run --profile tunnel.
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
# Public hostname of the tunnel must point to: http://gateway:80
TUNNEL_TOKEN=

SECRET_KEY=
MASTER_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Restricted DB role for workspace requests (Row Level Security enforced)
APP_DB_PASSWORD=
REDIS_PASSWORD=

# Optional: Sign in with Google (public OAuth client id, Web application)
GOOGLE_CLIENT_ID=
# Optional: Google Calendar sync also needs the secret
GOOGLE_CLIENT_SECRET=

# Optional: AI features (rule-based fallback without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Allow new accounts besides the first one (true for multi-user / e2e test stacks)
ALLOW_REGISTRATION=false

DEFAULT_TIMEZONE=Asia/Tashkent
GATEWAY_PORT=18090
